.venv/
__pycache__/
*.pyc
.pytest_cache/

# Ignore experimental_results/ except the testing inputs/Q&A we keep
experimental_results/*
!experimental_results/source_files/
!experimental_results/sample_q&a/

# HuggingFace dataset-download cache (multi-GB raw zips, reproducible)
experimental_results/source_files/uda_qa_cache/hf/

chunk-output/
user_chunks.json

# Scratch test scripts in mytests/ — only these are tracked
# (eval_support holds the Qdrant + metric helpers the eval scripts import)
src/ingest/mytests/*
!src/ingest/mytests/eval_support.py
!src/ingest/mytests/test_hybrid_retrieval.py
!src/ingest/mytests/test_reranker.py
!src/ingest/mytests/test_uda_consistency.py
!src/ingest/mytests/test_uda_eval.py