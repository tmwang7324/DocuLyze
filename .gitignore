# Firebase Admin credentials — never commit, anywhere in the tree
serviceAccountKey.json
**/serviceAccountKey.json
serviceAccount.json
**/serviceAccount.json

# Environment files — never commit, anywhere in the tree.
# Deliberately independent of the backend/ rule below: if that line is ever
# relaxed to track the Express source, secrets must stay ignored regardless.
# .env.example is the opt-out — a committed template with no real values.
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example

# Kubernetes secrets — raw (real values) and sealed output
kubernetes/doculyze-secrets.raw.yml
kubernetes/doculyze-sealed-secrets.yml
kubernetes/doculyze-secrets.yml

# Python-generated artifacts - never source
**/__pycache__/
**/*.py[cod]
**/*.egg-info/

# Local scratch and generated operational output
.scratch/
doculyze/doculyze/*-audit.json
doculyze/doculyze/logs-*.jsonl

# Installed dependencies — any depth
node_modules/
**/node_modules/

# Firebase emulator debug logs
*-debug.log
**/*-debug.log

# Development-only structured JSONL logs
logs/
**/logs/


backend/
.claude/
agents/


# code-explainer HTML output (build artifacts, not source)
code-explanations/
mono-server-experiment/

# Note / design-doc markdown files — ignored everywhere except README
*.md
!README.md
!**/README.md
# ...except converted-markdown test inputs (data, not notes)
!ingest-worker/experimental_results/source_files/**/*.md

