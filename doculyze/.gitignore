# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local log files
logs/

# env files (can opt-in for committing if needed)
.env*
.env.local
# The opt-out: a committed template with no real values. Must live here — a
# negation in the root .gitignore cannot override a positive rule in this file.
!.env.example

app/(protected)/upload/_archive/*


# local docs
CLAUDE.md
AGENTS.md

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# service account credentials
serviceAccount.json
