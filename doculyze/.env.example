# Server-side operational logging
LOG_LEVEL=info
# Daily rotation substitutes %DATE%; omit it to have it appended automatically.
LOG_FILE_PATH=logs/operational-%DATE%.jsonl

# Internal chat service (awesome-chat-service). Host dev: the compose dev override
# publishes it on 8001; running `python main.py` directly serves on 8000.
CHAT_SERVICE_URL=http://127.0.0.1:8001
